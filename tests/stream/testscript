# The messages and streams are in hex. In a stream each message follows its
# size as a varint.

: write
: Write messages preceded by their size
:
{{
  test.arguments += -w

  $* <'089601' >'03089601'         : message
  $* <'61*200' >~'/c801(61){200}/' : size-two-byte
  $* <:''      >''                 : none

  : messages
  : Messages one after another, an empty one included
  :
  $* <<EOI >'0308960100'
  089601

  EOI
}}

: read
: Read messages up to the end of the stream
:
{{
  test.arguments += -r

  $* <''                                : empty
  $* --size <'f0a204 61*70000' >'70000' : buffer

  : messages
  : Messages one after another, an empty one included
  :
  $* <'03089601 00' >>EOO
  089601

  EOO

  : skip
  : Rest of each message skipped over by next()
  :
  $* --first 1 <'03089601 02 0801' >>EOO
  08
  08
  EOO

  : skip-buffer
  : Rest of a message larger than the get area skipped over
  :
  $* --first 1 <'f0a204 61*70000 01 62' >>EOO
  61
  62
  EOO

  : limit
  : Message of the largest size that the limit allows
  :
  $* --max 4 <'04 61616161' >'61616161'

  : invalid
  : Malformed streams
  :
  {{
    : size-incomplete
    :
    $* <'80' 2>>EOE != 0
    error: incomplete message size
      info: at offset 0
    EOE

    : size-invalid
    : Size of more than 64 bits
    :
    $* <'ff*10' 2>>EOE != 0
    error: invalid message size
      info: at offset 0
    EOE

    : message-incomplete
    : Stream that ends inside the message
    :
    $* <'0361' 2>>EOE != 0
    error: incomplete message
      info: at offset 0
    EOE

    : skip-incomplete
    : Stream that ends inside the part of a message being skipped over
    :
    $* --first 1 <'f0a204 61*16384' 2>>EOE != 0
    error: incomplete message
      info: at offset 0
    EOE

    : position
    : Fault in the second message, at the offset of its size
    :
    $* <'03089601 0361' 2>>EOE != 0
    error: incomplete message
      info: at offset 4
    EOE

    : limit
    : Message larger than the limit
    :
    $* --max 3 <'04 61616161' 2>>EOE != 0
    error: message size 4 greater than limit 3
      info: at offset 0
    EOE
  }}
}}

: round-trip
: Messages written and read back
:
$* -w <<EOI | $* -r >>EOO
089601
0a0274657374
EOI
089601
0a0274657374
EOO

: round-trip-buffer
: Message larger than the put area, written and read back
:
$* -w <'61*40000' | $* -r --size >'40000'
