intf_libs = # Interface dependencies.
impl_libs = # Implementation dependencies.

# We use ICU to validate UTF-8 in string fields. It is an implementation
# dependency since none of our public headers include ICU headers.
#
import impl_libs += libicuuc%lib{icuuc}

lib{protobuf}: {hxx ixx txx cxx}{** -version} hxx{version} $impl_libs $intf_libs

hxx{version}: in{version} $src_root/manifest

# Build options.
#
cxx.poptions =+ "-I$out_root" "-I$src_root"

obja{*}: cxx.poptions += -DLIBPROTOBUF_STATIC_BUILD
objs{*}: cxx.poptions += -DLIBPROTOBUF_SHARED_BUILD

# Export options.
#
lib{protobuf}:
{
  cxx.export.poptions = "-I$out_root" "-I$src_root"
  cxx.export.libs = $intf_libs
}

liba{protobuf}: cxx.export.poptions += -DLIBPROTOBUF_STATIC
libs{protobuf}: cxx.export.poptions += -DLIBPROTOBUF_SHARED

# For pre-releases use the complete version to make sure they cannot
# be used in place of another pre-release or the final version. See
# the version module for details on the version.* variable values.
#
if $version.pre_release
  lib{protobuf}: bin.lib.version = "-$version.project_id"
else
  lib{protobuf}: bin.lib.version = "-$version.major.$version.minor"

# Install into the libprotobuf/ subdirectory of, say, /usr/include/
# recreating subdirectories.
#
{hxx ixx txx}{*}:
{
  install         = include/libprotobuf/
  install.subdirs = true
}

# Don't install the varint coding header since it's an implementation
# detail that no public header includes.
#
hxx{varint}@./: install = false
